# Copie ce fichier en .env.local et remplis les valeurs (jamais de vraie clé ici).

# Adresse de la base. Vide en local : SQLite dans .data/crm-btp.db.
# En prod (Turso) : libsql://<nom-de-la-base>-<compte>.turso.io
DATABASE_URL=

# Jeton Turso (turso db tokens create <nom-de-la-base>). Inutile en local.
DATABASE_AUTH_TOKEN=

# Secret partagé pour signer les webhooks (ex. : openssl rand -hex 32).
WEBHOOK_SECRET=
